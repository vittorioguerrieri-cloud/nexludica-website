---
import ResearchLayout from "../../layouts/ResearchLayout.astro";
import { getDb, getEnv } from "../../server/db";
import { listStudies, listQuestionnaires, countResponses, type Study } from "../../server/research";
import { getUser } from "../../server/guards";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "no-store, max-age=0, must-revalidate");

const user = await getUser(Astro);
if (!user || user.role !== "admin") {
  return Astro.redirect("/no-access");
}

const env = await getEnv();
const db = getDb(env as Env)!;

const studies = await listStudies(db);

type StudyOverview = {
  study: Study;
  totalResponses: number;
  questionnaires: Array<{
    id: string;
    slug: string;
    title: string;
    status: string;
    count: number;
  }>;
};

const overviews: StudyOverview[] = [];
for (const s of studies) {
  const qs = await listQuestionnaires(db, s.id);
  const counts = await countResponses(db, s.id);
  const countMap = new Map(counts.map((c) => [c.questionnaireId, c.count]));
  overviews.push({
    study: s,
    totalResponses: counts.reduce((sum, c) => sum + c.count, 0),
    questionnaires: qs.map((q) => ({
      id: q.id,
      slug: q.slug,
      title: q.title,
      status: q.status,
      count: countMap.get(q.id) ?? 0,
    })),
  });
}
---

<ResearchLayout title="NexLudica Research — Admin">
  <section>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.3em] text-nx-cyan">Admin dashboard</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight text-nx-dark sm:text-4xl" style="font-family: var(--font-display);">
          NexLudica Research
        </h1>
        <p class="mt-2 text-sm text-nx-gray-dark">
          Logged in as <span class="font-semibold text-nx-dark">{user.email}</span>.
          I partecipanti accedono ai questionari solo tramite link diretto.
        </p>
      </div>
      <a
        href="/admin/responses"
        class="rounded-lg bg-nx-cyan px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white no-underline shadow-sm transition hover:bg-nx-blue"
      >
        Responses →
      </a>
    </div>
  </section>

  <section class="mt-10 space-y-6">
    {overviews.map(({ study, totalResponses, questionnaires }) => (
      <div class="rounded-xl border border-nx-gray-light/20 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-nx-dark">{study.title}</h2>
              <span class:list={[
                "rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider",
                study.status === "active" ? "bg-green-100 text-green-700" : "bg-nx-gray-light/30 text-nx-gray-dark",
              ]}>
                {study.status}
              </span>
              {study.publicListing ? (
                <span class="rounded-full bg-nx-cyan/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-nx-cyan">
                  Public
                </span>
              ) : (
                <span class="rounded-full bg-nx-gray-light/30 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-nx-gray-dark">
                  Private
                </span>
              )}
            </div>
            <p class="mt-1 font-mono text-xs text-nx-gray-dark">/{study.slug}</p>
          </div>
          <div class="text-right">
            <p class="text-2xl font-black text-nx-cyan">{totalResponses}</p>
            <p class="text-[10px] font-bold uppercase tracking-wider text-nx-gray-dark">responses</p>
          </div>
        </div>

        {study.prolificCompletionUrl && (
          <p class="mt-3 truncate text-xs text-nx-gray-dark">
            <span class="font-semibold text-nx-dark">Prolific URL:</span>
            <a href={study.prolificCompletionUrl} class="ml-1 text-nx-cyan no-underline hover:underline">{study.prolificCompletionUrl}</a>
          </p>
        )}

        <div class="mt-4 space-y-2">
          {questionnaires.map((q) => {
            const directLink = `https://research.nexludica.org/${study.slug}/${q.slug}`;
            return (
              <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-nx-gray-light/10 bg-nx-off-white px-4 py-3">
                <div class="min-w-0 flex-1">
                  <p class="text-sm font-semibold text-nx-dark">{q.title}</p>
                  <p class="mt-0.5 truncate font-mono text-[11px] text-nx-gray-dark">{directLink}</p>
                </div>
                <div class="flex items-center gap-3 text-xs">
                  <span class="text-nx-gray-dark">{q.count} resp.</span>
                  <a
                    href={`/${study.slug}/${q.slug}`}
                    class="rounded-md border border-nx-cyan/40 px-3 py-1 font-semibold text-nx-cyan no-underline hover:bg-nx-cyan hover:text-white"
                  >
                    Open
                  </a>
                  <a
                    href={`/admin/responses?study=${study.slug}`}
                    class="rounded-md bg-nx-dark px-3 py-1 font-semibold text-white no-underline hover:bg-nx-blue"
                  >
                    Data
                  </a>
                </div>
              </div>
            );
          })}
          {questionnaires.length === 0 && (
            <p class="text-xs italic text-nx-gray-dark">Nessun questionario.</p>
          )}
        </div>
      </div>
    ))}
  </section>
</ResearchLayout>
