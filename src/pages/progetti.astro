---
import BaseLayout from "../layouts/BaseLayout.astro";

// Giochi da tavolo che NexLudica sostiene attivamente.
// I logo vanno droppati in public/images/games/ con i nomi indicati sotto.
const giochiSostenuti = [
  {
    title: "Pink*",
    subtitle: "Un gioco da ragazze?",
    description:
      "Gioco da tavolo transfemminista sulle discriminazioni di genere, ideato da Valeria Cammarosano, Benedetta Francioni e Letizia Vaccarella. Affronta disparità e violenza di genere attraverso il gioco, partendo dall'idea che informazione ed educazione siano i primi passi per cambiare. NexLudica ne cura promozione e distribuzione.",
    logo: "/images/games/pink.png",
    logoBg: "#E5187E",
    link: "https://www.pinkers.it/",
    linkLabel: "pinkers.it",
  },
  {
    title: "WarFables",
    subtitle: "Skirmish · Wargame a squadre",
    description:
      "Wargame skirmish a squadre in cui due gruppi di eroi si scontrano per completare una missione, ideato da Marco Monteverde, Simone Glogowschek e Vittorio Guerrieri. NexLudica lo utilizza come strumento per favorire la reintegrazione sociale delle persone più fragili, e ne cura promozione, produzione e distribuzione.",
    logo: "/images/games/warfables.jpg",
    logoBg: "#f5f5f4",
  },
];

const progetti = [
  {
    title: "Wanderer's Quest",
    tagline: "Ricerca · Giovani NEET",
    status: "In corso",
    description: "Iniziativa di ricerca che usa il gioco da tavolo come strumento di trasformazione sociale per giovani NEET (Not in Education, Employment, or Training). Il progetto interpreta questa fase di transizione come un viaggio di esplorazione personale e analizza come il gioco possa promuovere fiducia, socializzazione e competenze trasversali.",
    partners: ["Università di Milano-Bicocca"],
    objectives: [
      "Approfondire il ruolo motivazionale e psicologico del gioco da tavolo nei giovani NEET",
      "Analizzare come il gioco da tavolo promuova fiducia, socializzazione e competenze trasversali",
      "Sviluppare un intervento standardizzato e replicabile per enti del terzo settore",
    ],
  },
  {
    title: "Giochi al Pesto",
    tagline: "Eventi · Inclusione · Genova",
    status: "Attivo",
    description: "Serate di gioco da tavolo e gioco di ruolo gratuite, aperte a chiunque, in diverse sedi della città metropolitana di Genova. Il progetto bandiera di NexLudica per riconnettere il tessuto sociale giovanile attraverso il gioco.",
    partners: ["Centro di Solidarietà di Genova"],
    link: "https://giochialpesto.it",
  },
  {
    title: "MeetLudica",
    tagline: "Network scientifico",
    status: "Attivo",
    description: "Incontro mensile online che riunisce chi fa ricerca sul gioco da tavolo. Ogni ultimo giovedì del mese alle 19:00: 30 minuti di presentazione di un progetto di ricerca in corso, seguiti da un'ora di confronto e discussione. L'iniziativa mira a rendere la ricerca ludica più accessibile e a favorire le connessioni nella community di ricerca.",
    partners: [],
  },
  {
    title: "Research Platform",
    tagline: "Ricerca · Questionari psicometrici",
    status: "Attivo",
    description: "Piattaforma proprietaria di NexLudica per condurre studi psicometrici sull'impatto del gioco da tavolo. Ospita batterie di questionari validati per ricerche su benessere, dinamiche di gruppo, processi cognitivi. I dati sono trattati in forma anonima e conservati su server europei.",
    partners: [],
    link: "https://research.nexludica.org",
  },
];
---

<BaseLayout title="Progetti — NexLudica APS" description="I progetti di NexLudica: Wanderer's Quest, Giochi al Pesto, MeetLudica. Ricerca, eventi ed equità attraverso il gioco da tavolo.">
  <section class="nx-hero-pattern px-4 pb-16 pt-28 text-center">
    <h1 class="text-4xl font-extrabold text-nx-dark md:text-5xl" style="font-family: var(--font-display);">
      I nostri progetti
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-nx-gray-dark">
      Dalla ricerca scientifica agli eventi sul territorio: ecco come portiamo
      avanti la nostra missione.
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <div class="space-y-8">
      {progetti.map((progetto) => (
        <article class="rounded-xl border border-nx-gray-light/20 bg-white p-8 shadow-sm transition hover:shadow-md">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h2 class="text-2xl font-bold text-nx-dark">{progetto.title}</h2>
              <p class="mt-1 text-xs uppercase tracking-wider text-nx-cyan">{progetto.tagline}</p>
            </div>
            <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-semibold ${
              progetto.status === "Attivo"
                ? "bg-emerald-100 text-emerald-700"
                : "bg-amber-100 text-amber-700"
            }`}>
              {progetto.status}
            </span>
          </div>
          <p class="mt-4 text-nx-gray-dark leading-relaxed">{progetto.description}</p>
          {progetto.objectives && (
            <div class="mt-4">
              <p class="text-sm font-semibold text-nx-dark">Obiettivi</p>
              <ul class="mt-2 space-y-1">
                {progetto.objectives.map((o) => (
                  <li class="flex items-start gap-2 text-sm text-nx-gray-dark">
                    <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-nx-cyan"></span>
                    <span>{o}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {progetto.partners && progetto.partners.length > 0 && (
            <div class="mt-4">
              <p class="text-sm font-semibold text-nx-dark">In collaborazione con</p>
              <div class="mt-2 flex flex-wrap gap-2">
                {progetto.partners.map((p) => (
                  <span class="rounded-full bg-nx-off-white px-3 py-1 text-xs text-nx-gray-dark">
                    {p}
                  </span>
                ))}
              </div>
            </div>
          )}
          {progetto.link && (
            <a
              href={progetto.link}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-nx-cyan no-underline hover:underline"
            >
              Visita il sito &rarr;
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Sezione: Giochi che sosteniamo (in fondo alla pagina) -->
  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div class="mb-8">
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Partnership ludiche</p>
      <h2 class="mt-2 text-2xl font-bold text-nx-dark sm:text-3xl" style="font-family: var(--font-display);">
        Giochi da tavolo che sosteniamo
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-nx-gray-dark">
        Progetti ludici che condividono la nostra visione del gioco come strumento
        di crescita ed equità, e che diffondiamo nelle nostre attivita'.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      {giochiSostenuti.map((g) => (
        <article class="overflow-hidden rounded-xl border border-nx-gray-light/20 bg-white shadow-sm transition hover:shadow-md">
          {/* Banner immagine assottigliato: object-fit:cover ritaglia top e
              bottom per ottenere una fascia orizzontale piu' compatta. */}
          <div class="relative w-full overflow-hidden" style={`background-color: ${g.logoBg}; height: 160px;`}>
            <img
              src={g.logo}
              alt={`${g.title} logo`}
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
              style="object-position: center;"
            />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-nx-dark">{g.title}</h3>
            {g.subtitle && (
              <p class="mt-0.5 text-xs uppercase tracking-wider text-nx-cyan">{g.subtitle}</p>
            )}
            <p class="mt-3 text-sm text-nx-gray-dark leading-relaxed">{g.description}</p>
            {g.link && (
              <a
                href={g.link}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-nx-cyan no-underline hover:underline"
              >
                {g.linkLabel ?? "Scopri di piu'"} &rarr;
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
