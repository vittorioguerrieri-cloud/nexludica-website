---
/**
 * Pagina profilo pubblica di un socio: /chi-siamo/<slug>
 *
 * Contiene:
 *  - Header con foto, nome, ruolo, skills, link social
 *  - Bio breve
 *  - CV accademico (formato strutturato, opzionale)
 *  - Altro (CV stile standard, opzionale)
 *  - Campi custom (label/value, opzionali)
 *  - Articoli MeetLudica scritti dalla persona (in fondo)
 *  - Form di contatto (invia email senza esporre l'indirizzo)
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDb, getEnv } from "../../server/db";
import { getPublicMemberBySlug } from "../../server/profiles";
import { listPublishedArticles } from "../../server/articles";
import { listPublicationsByUser, type PublicationView } from "../../server/publications";
import { listAwardsByUser, type AwardView } from "../../server/awards";
import StructuredText from "../../components/StructuredText.astro";

export const prerender = false;

const slug = (Astro.params.slug as string).trim();
const env = await getEnv();
const db = getDb(env as Env);

// Stato della richiesta: se il backend è giù mostriamo errore in pagina,
// non un response 503 nudo (che rompe l'esperienza visiva).
type LoadState =
  | { kind: "ok"; member: NonNullable<Awaited<ReturnType<typeof getPublicMemberBySlug>>>; articles: Awaited<ReturnType<typeof listPublishedArticles>>; publications: PublicationView[]; awards: AwardView[] }
  | { kind: "not_found" }
  | { kind: "backend_down" };

let state: LoadState;
if (!db) {
  state = { kind: "backend_down" };
} else {
  const member = await getPublicMemberBySlug(db, slug);
  if (!member) {
    state = { kind: "not_found" };
    Astro.response.status = 404;
  } else {
    const allArticles = await listPublishedArticles(db);
    const publications = await listPublicationsByUser(db, member.userId);
    const awards = await listAwardsByUser(db, member.userId);
    state = {
      kind: "ok",
      member,
      articles: allArticles.filter((a) => a.userId === member.userId),
      publications,
      awards,
    };
  }
}

const member = state.kind === "ok" ? state.member : null;
const memberArticles = state.kind === "ok" ? state.articles : [];
const memberPublications = state.kind === "ok" ? state.publications : [];
const memberAwards = state.kind === "ok" ? state.awards : [];

const title = member ? `${member.name} — NexLudica` : "Profilo — NexLudica";
const description = member ? (member.bio ?? `Profilo di ${member.name} su NexLudica.`) : "Profilo NexLudica APS";

function formatDate(s: string | null) {
  if (!s) return "";
  // YYYY-MM-DD viene parsato come UTC midnight da new Date(): in TZ
  // negative mostra il giorno precedente. Forziamo l'interpretazione
  // come data locale parsando i pezzi a mano.
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s);
  if (m) {
    const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
    return d.toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" });
  }
  try { return new Date(s).toLocaleDateString("it-IT", { day: "numeric", month: "long", year: "numeric" }); }
  catch { return s; }
}
---

<BaseLayout title={title} description={description} noindex={state.kind !== "ok"}>
  <section class="mx-auto max-w-4xl px-4 pb-16 pt-12">
    <a href="/chi-siamo" class="text-xs font-semibold uppercase tracking-[0.25em] text-nx-gray-dark no-underline hover:text-nx-cyan">
      ← Tutto il team
    </a>

    {state.kind === "backend_down" && (
      <div class="mt-10 rounded-xl border-2 border-amber-200 bg-amber-50 p-8 text-center">
        <h1 class="text-2xl font-bold text-nx-dark">Servizio momentaneamente non disponibile</h1>
        <p class="mt-3 text-sm text-nx-gray-dark">
          Stiamo avendo problemi nel raggiungere il database. Riprova fra qualche minuto.
        </p>
      </div>
    )}

    {state.kind === "not_found" && (
      <div class="mt-10 rounded-xl border-2 border-nx-gray-light/30 bg-white p-8 text-center">
        <h1 class="text-2xl font-bold text-nx-dark">Profilo non trovato</h1>
        <p class="mt-3 text-sm text-nx-gray-dark">
          Il profilo che cerchi non esiste o non e' piu' pubblico.
        </p>
        <a href="/chi-siamo" class="mt-6 inline-block text-sm font-semibold text-nx-cyan no-underline hover:underline">
          ← Torna al team
        </a>
      </div>
    )}

    {member && (
      <>
    <!-- Header profilo -->
    <header class="mt-6 grid gap-8 sm:grid-cols-[200px_1fr] sm:items-start">
      <div class="overflow-hidden rounded-2xl bg-nx-off-white">
        {member.photoUrl ? (
          <img src={member.photoUrl} alt={member.name} loading="eager" decoding="async" class="aspect-square h-full w-full object-cover" />
        ) : (
          <div class="flex aspect-square w-full items-center justify-center bg-nx-cyan-light">
            <span class="text-6xl font-black text-nx-cyan">
              {member.name.split(" ").filter(Boolean).map((s) => s[0]).slice(0, 2).join("")}
            </span>
          </div>
        )}
      </div>
      <div>
        {member.roleLabel && (
          <p class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">{member.roleLabel}</p>
        )}
        <h1 class="mt-2 text-3xl font-black tracking-tight text-nx-dark sm:text-4xl" style="font-family: var(--font-display);">
          {member.name}
        </h1>
        {member.skills && (
          <p class="mt-2 text-sm text-nx-gray-dark">{member.skills}</p>
        )}
        {member.bio && (
          <p class="mt-4 whitespace-pre-line text-base text-nx-gray-dark leading-relaxed">{member.bio}</p>
        )}
        <!-- Link e contact button -->
        <div class="mt-5 flex flex-wrap gap-3 text-sm">
          <a href="#contatto" class="inline-flex items-center gap-1.5 rounded-lg bg-nx-cyan px-4 py-2 font-semibold text-white no-underline shadow-sm transition hover:bg-nx-blue">
            ✉ Scrivimi
          </a>
          {member.website && (
            <a href={member.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg border border-nx-gray-light/40 bg-white px-4 py-2 font-medium text-nx-dark no-underline hover:border-nx-cyan hover:text-nx-cyan">
              Sito web ↗
            </a>
          )}
          {member.instagram && (
            <a href={member.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-lg border border-nx-gray-light/40 bg-white px-4 py-2 font-medium text-nx-dark no-underline hover:border-nx-cyan hover:text-nx-cyan">
              Instagram ↗
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Informazioni generali (era "Altre informazioni") — spostata in cima -->
    {member.cvOther && (
      <section class="mt-12">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Informazioni generali</h2>
        <div class="mt-4 rounded-xl border border-nx-gray-light/20 bg-white p-6">
          <StructuredText text={member.cvOther} />
        </div>
      </section>
    )}

    <!-- Curriculum accademico -->
    {member.cvAcademic && (
      <section class="mt-10">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Curriculum accademico</h2>
        <h3 class="mt-2 text-2xl font-bold text-nx-dark" style="font-family: var(--font-display);">Formazione e attività di ricerca</h3>
        <div class="mt-4 rounded-xl border border-nx-gray-light/20 bg-white p-6">
          <StructuredText text={member.cvAcademic} />
        </div>
      </section>
    )}

    <!-- Pubblicazioni (nuova sezione, formato accademico con DOI) -->
    {memberPublications.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Pubblicazioni</h2>
        <h3 class="mt-2 text-2xl font-bold text-nx-dark" style="font-family: var(--font-display);">Articoli, capitoli, atti</h3>
        <ol class="mt-6 space-y-4">
          {memberPublications.map((p) => (
            <li class="rounded-xl border border-nx-gray-light/20 bg-white p-5">
              {p.authors && (
                <p class="text-xs text-nx-gray-dark">{p.authors}{p.year ? ` (${p.year})` : ""}</p>
              )}
              {!p.authors && p.year && (
                <p class="text-xs text-nx-gray-dark">{p.year}</p>
              )}
              <p class="mt-1 text-base font-semibold text-nx-dark leading-snug">{p.title}</p>
              {p.venue && (
                <p class="mt-1 text-sm italic text-nx-gray-dark">{p.venue}</p>
              )}
              {(p.doi || p.url) && (
                <p class="mt-2 text-xs">
                  {p.doi && (
                    <a
                      href={`https://doi.org/${p.doi}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 rounded-full border border-nx-cyan/30 bg-nx-cyan-light/30 px-2.5 py-0.5 font-mono font-semibold text-nx-cyan no-underline hover:bg-nx-cyan-light/60"
                    >
                      doi:{p.doi}
                    </a>
                  )}
                  {!p.doi && p.url && (
                    <a href={p.url} target="_blank" rel="noopener noreferrer" class="font-semibold text-nx-cyan no-underline hover:underline">
                      Link al documento ↗
                    </a>
                  )}
                </p>
              )}
              {p.abstract && (
                <details class="nx-abstract mt-3 rounded-lg bg-nx-off-white">
                  <summary class="flex cursor-pointer items-center gap-2 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-nx-cyan hover:text-nx-blue">
                    <span class="nx-abstract-icon transition-transform">▶</span>
                    <span>Abstract</span>
                  </summary>
                  <div class="px-4 pb-4 pt-1 text-sm leading-relaxed text-nx-gray-dark">
                    {p.abstract}
                  </div>
                </details>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    <!-- Premi e riconoscimenti -->
    {memberAwards.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Premi e riconoscimenti</h2>
        <h3 class="mt-2 text-2xl font-bold text-nx-dark" style="font-family: var(--font-display);">Awards</h3>
        <ul class="mt-6 space-y-3">
          {memberAwards.map((a) => (
            <li class="flex items-start gap-4 rounded-xl border border-nx-gray-light/20 bg-white p-5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-nx-cyan-light text-xl">
                🏆
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-base font-bold text-nx-dark leading-snug">{a.title}</p>
                {(a.issuer || a.year) && (
                  <p class="mt-0.5 text-sm text-nx-gray-dark">
                    {a.issuer}{a.issuer && a.year ? " · " : ""}{a.year ? a.year : ""}
                  </p>
                )}
                {a.description && (
                  <p class="mt-2 whitespace-pre-line text-sm text-nx-gray-dark leading-relaxed">{a.description}</p>
                )}
                {a.url && (
                  <a href={a.url} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-nx-cyan no-underline hover:underline">
                    Maggiori informazioni ↗
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- Custom fields -->
    {member.customFields.length > 0 && (
      <section class="mt-10">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Altri dettagli</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          {member.customFields.map((f) => (
            <div class="rounded-xl border border-nx-gray-light/20 bg-white p-4">
              <dt class="text-xs font-semibold uppercase tracking-wider text-nx-gray-dark">{f.label}</dt>
              <dd class="mt-1 whitespace-pre-line text-sm text-nx-dark">{f.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <!-- Articoli MeetLudica -->
    {memberArticles.length > 0 && (
      <section class="mt-12">
        <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">MeetLudica</h2>
        <h3 class="mt-2 text-2xl font-bold text-nx-dark" style="font-family: var(--font-display);">
          Articoli e interventi
        </h3>
        <ul class="mt-6 space-y-3">
          {memberArticles.map((a) => (
            <li>
              <a
                href={`/meetludica#${a.slug}`}
                class="group flex flex-col gap-2 rounded-xl border border-nx-gray-light/20 bg-white p-5 no-underline transition hover:border-nx-cyan hover:shadow-md sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
              >
                <div>
                  <p class="text-base font-bold text-nx-dark group-hover:text-nx-cyan">{a.title}</p>
                  {a.abstract && (
                    <p class="mt-1 text-sm text-nx-gray-dark line-clamp-2">{a.abstract}</p>
                  )}
                </div>
                <span class="shrink-0 text-xs font-medium uppercase tracking-wider text-nx-gray-dark">
                  {formatDate(a.meetingDate)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <style>
      details.nx-abstract[open] > summary > .nx-abstract-icon {
        transform: rotate(90deg);
      }
      details.nx-abstract > summary { list-style: none; }
      details.nx-abstract > summary::-webkit-details-marker { display: none; }
    </style>

    <!-- Contact form -->
    <section id="contatto" class="mt-12 rounded-2xl border border-nx-cyan/30 bg-nx-cyan-light/20 p-6 sm:p-8">
      <h2 class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Contatto</h2>
      <h3 class="mt-2 text-2xl font-bold text-nx-dark" style="font-family: var(--font-display);">
        Scrivi a {member.name.split(" ")[0]}
      </h3>
      <p class="mt-2 text-sm text-nx-gray-dark">
        Il messaggio verrà inoltrato via email senza condividere il tuo indirizzo pubblicamente.
        {member.name.split(" ")[0]} risponderà direttamente all'email che inserisci qui sotto.
      </p>
      <form id="contact-form" class="mt-6 grid gap-4 sm:grid-cols-2">
        <input type="hidden" name="userId" value={member.userId} />
        <!-- Honeypot: campo invisibile che i bot tendono a riempire. Se popolato, l'endpoint scarta silenziosamente. -->
        <input type="text" name="company" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px; opacity:0; pointer-events:none;" />
        <div>
          <label class="block text-sm font-medium text-nx-dark">Il tuo nome <span class="text-red-500">*</span></label>
          <input name="senderName" required maxlength="100" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 bg-white px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div>
          <label class="block text-sm font-medium text-nx-dark">La tua email <span class="text-red-500">*</span></label>
          <input type="email" name="senderEmail" required maxlength="200" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 bg-white px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium text-nx-dark">Oggetto</label>
          <input name="subject" maxlength="150" placeholder={`Re: ${member.name}`} class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 bg-white px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium text-nx-dark">Messaggio <span class="text-red-500">*</span></label>
          <textarea name="message" required rows="6" maxlength="3000" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 bg-white px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20"></textarea>
        </div>
        <div class="sm:col-span-2 flex flex-wrap items-center gap-4">
          <button type="submit" id="contact-submit" class="rounded-lg bg-nx-cyan px-6 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-nx-blue disabled:opacity-50">
            Invia messaggio
          </button>
          <span id="contact-status" class="text-sm"></span>
        </div>
      </form>
    </section>
      </>
    )}
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    if (!form) return;
    const statusEl = document.getElementById("contact-status");
    const submitBtn = document.getElementById("contact-submit");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      statusEl.textContent = "Invio in corso...";
      statusEl.className = "text-sm text-nx-gray-dark";
      const fd = new FormData(form);
      const body = Object.fromEntries(fd.entries());
      try {
        const res = await fetch("/api/contact-member", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          statusEl.textContent = "Errore: " + (data.error || res.status);
          statusEl.className = "text-sm text-red-600";
          submitBtn.disabled = false;
          return;
        }
        statusEl.textContent = "✓ Messaggio inviato.";
        statusEl.className = "text-sm font-semibold text-emerald-600";
        form.reset();
      } catch (err) {
        statusEl.textContent = "Errore di rete";
        statusEl.className = "text-sm text-red-600";
        submitBtn.disabled = false;
      }
    });
  })();
</script>
