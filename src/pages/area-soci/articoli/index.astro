---
import AreaSociLayout from "../../../layouts/AreaSociLayout.astro";
import { getDb, getEnv } from "../../../server/db";
import { listMyArticles } from "../../../server/articles";
import { getUser } from "../../../server/guards";

export const prerender = false;

const user = await getUser(Astro);
if (!user) {
  return Astro.redirect("/login");
}
const env = await getEnv();
const db = getDb(env as Env);
let articles: Awaited<ReturnType<typeof listMyArticles>> = [];
if (db) {
  try {
    articles = await listMyArticles(db, user.id);
  } catch (e) {
    console.error("[articoli] db error:", e);
  }
}
---

<AreaSociLayout title="I miei articoli — Area Soci" active="articoli">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-nx-dark">I miei resoconti MeetLudica</h2>
      <p class="mt-1 text-sm text-nx-gray-dark">
        Gestisci i resoconti che hai pubblicato. Quelli "published" appaiono nell'archivio pubblico.
      </p>
    </div>
    <a href="/area-soci/articoli/nuovo" class="rounded-lg bg-nx-cyan px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white no-underline shadow-lg shadow-nx-cyan/30 transition hover:-translate-y-0.5 hover:bg-nx-blue">
      + Nuovo resoconto
    </a>
  </div>

  {articles.length === 0 ? (
    <div class="mt-8 rounded-xl border-2 border-dashed border-nx-gray-light/40 bg-white p-12 text-center">
      <p class="text-base font-semibold text-nx-dark">Nessun resoconto ancora</p>
      <p class="mt-2 text-sm text-nx-gray-dark">Pubblica il tuo primo resoconto MeetLudica.</p>
      <a href="/area-soci/articoli/nuovo" class="mt-4 inline-block rounded-lg bg-nx-cyan px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white no-underline transition hover:bg-nx-blue">
        Carica resoconto
      </a>
    </div>
  ) : (
    <ul class="mt-8 space-y-4">
      {articles.map((a) => (
        <li class="rounded-xl border border-nx-gray-light/20 bg-white p-6">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <span class={`rounded-full px-2 py-0.5 text-xs font-bold uppercase tracking-wider ${
                  a.status === "published" ? "bg-emerald-100 text-emerald-700"
                  : a.status === "draft" ? "bg-amber-100 text-amber-700"
                  : "bg-nx-gray-light/30 text-nx-gray-dark"
                }`}>{a.status}</span>
                <span class="text-xs text-nx-gray-dark">{a.meetingDate}</span>
              </div>
              <h3 class="mt-2 text-lg font-bold text-nx-dark">{a.title}</h3>
              <p class="mt-1 text-sm text-nx-gray-dark">{a.speaker}</p>
              <p class="mt-3 line-clamp-3 text-sm text-nx-gray-dark">{a.abstract}</p>
              <div class="mt-3 flex flex-wrap gap-3 text-xs">
                <a href={`/meetludica/${a.slug}`} target="_blank" rel="noopener noreferrer" class="text-nx-cyan no-underline hover:underline">↗ Pagina</a>
                {a.body && (
                  <a href={`/api/meetludica/articles/${a.slug}/pdf`} target="_blank" rel="noopener noreferrer" class="text-nx-cyan no-underline hover:underline">📄 PDF</a>
                )}
                {a.documentUrl && (
                  <a href={a.documentUrl} target="_blank" rel="noopener noreferrer" class="text-nx-cyan no-underline hover:underline">📎 Allegato</a>
                )}
                {a.videoUrl && (
                  <a href={a.videoUrl} target="_blank" rel="noopener noreferrer" class="text-nx-cyan no-underline hover:underline">🔗 Progetto</a>
                )}
              </div>
              {a.editToken && (
                <div class="mt-3 rounded-lg bg-nx-off-white p-3">
                  <p class="text-[11px] font-semibold uppercase tracking-wider text-nx-gray-dark">Link di modifica per l'autore (no login)</p>
                  <div class="mt-1 flex flex-wrap items-center gap-2">
                    <input
                      type="text"
                      readonly
                      value={`https://www.nexludica.org/meetludica/modifica/${a.editToken}`}
                      class="js-edit-link min-w-0 flex-1 rounded border border-nx-gray-light/40 bg-white px-2 py-1 font-mono text-[11px] text-nx-gray-dark"
                    />
                    <button type="button" data-copy-link={`https://www.nexludica.org/meetludica/modifica/${a.editToken}`} class="js-copy shrink-0 rounded border border-nx-cyan/40 px-3 py-1 text-[11px] font-semibold text-nx-cyan hover:bg-nx-cyan-light/30">
                      Copia
                    </button>
                  </div>
                  <p class="mt-1 text-[10px] text-nx-gray-dark">Invialo al relatore: potrà modificare il proprio articolo senza essere socio.</p>
                </div>
              )}
            </div>
            <button
              data-delete-id={a.id}
              data-delete-title={a.title}
              class="js-delete shrink-0 rounded-md border border-red-200 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-red-700 transition hover:bg-red-50"
            >
              Elimina
            </button>
          </div>
        </li>
      ))}
    </ul>
  )}
</AreaSociLayout>

<script is:inline>
  (function () {
    document.querySelectorAll(".js-copy").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const link = btn.getAttribute("data-copy-link");
        try {
          await navigator.clipboard.writeText(link);
          const orig = btn.textContent;
          btn.textContent = "✓ Copiato";
          setTimeout(function () { btn.textContent = orig; }, 1500);
        } catch (e) {
          const input = btn.parentElement.querySelector(".js-edit-link");
          if (input) { input.select(); document.execCommand("copy"); }
        }
      });
    });

    document.querySelectorAll(".js-delete").forEach(function (btn) {
      btn.addEventListener("click", async function () {
        const id = btn.getAttribute("data-delete-id");
        const title = btn.getAttribute("data-delete-title") || "questo articolo";
        if (!confirm(`Eliminare "${title}"? L'azione è irreversibile.`)) return;
        btn.disabled = true;
        const res = await fetch("/api/articles/" + encodeURIComponent(id), { method: "DELETE" });
        if (res.ok) {
          window.location.reload();
        } else {
          alert("Errore durante l'eliminazione");
          btn.disabled = false;
        }
      });
    });
  })();
</script>
