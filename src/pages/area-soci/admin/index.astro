---
import AreaSociLayout from "../../../layouts/AreaSociLayout.astro";
import { getDb, getEnv } from "../../../server/db";
import { getUser } from "../../../server/guards";
import { listAllMembers, type AdminMemberView } from "../../../server/admin";

export const prerender = false;

const user = await getUser(Astro);
if (!user) return Astro.redirect("/login");
if (user.role !== "admin") return Astro.redirect("/area-soci");

const env = await getEnv();
const db = getDb(env as Env);
let members: AdminMemberView[] = [];
if (db) {
  try {
    members = await listAllMembers(db);
  } catch (e) {
    console.error("[admin] list members error:", e);
  }
}

function fmt(s: string | null) {
  return s && s.trim() ? s : "—";
}
function fmtDate(s: string | null) {
  if (!s) return "—";
  try {
    return new Date(s).toLocaleDateString("it-IT");
  } catch {
    return s;
  }
}
function fmtMoney(n: number | null) {
  if (n == null) return "—";
  return `€ ${n.toFixed(2).replace(".", ",")}`;
}
const roleLabels: Record<string, string> = {
  admin: "Admin",
  member: "Sociə",
  collaborator: "Collaboratorə",
};
const statusLabels: Record<string, string> = {
  active: "Attivə",
  pending: "In attesa",
  suspended: "Sospesə",
  former: "Ex sociə",
};
const statusColors: Record<string, string> = {
  active: "bg-emerald-100 text-emerald-800",
  pending: "bg-amber-100 text-amber-800",
  suspended: "bg-red-100 text-red-800",
  former: "bg-nx-gray-light/30 text-nx-gray-dark",
};
---

<AreaSociLayout title="Amministrazione — Area Soci" active="admin">
  <div class="flex flex-wrap items-baseline justify-between gap-4">
    <div>
      <h2 class="text-2xl font-bold text-nx-dark">Persone iscritte</h2>
      <p class="mt-1 text-sm text-nx-gray-dark">
        Gestione completa di chi è iscritto. Visibile solo agli admin.
      </p>
    </div>
    <div class="flex flex-wrap gap-3">
      <button id="invite-btn" class="rounded-lg border border-nx-cyan/40 bg-white px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-nx-cyan transition hover:-translate-y-0.5 hover:border-nx-cyan hover:bg-nx-cyan-light/30">
        🔗 Genera link iscrizione
      </button>
      <a href="/area-soci/admin/nuovo" class="rounded-lg bg-nx-cyan px-5 py-2.5 text-sm font-bold uppercase tracking-wider text-white no-underline shadow-lg shadow-nx-cyan/30 transition hover:-translate-y-0.5 hover:bg-nx-blue">
        + Nuova iscrizione
      </a>
    </div>
  </div>

  <!-- Modal: genera link iscrizione -->
  <div id="invite-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 p-4">
    <div class="w-full max-w-lg rounded-xl bg-white p-6 shadow-xl">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="text-lg font-bold text-nx-dark">Genera link iscrizione</h3>
          <p class="mt-1 text-xs text-nx-gray-dark">
            Il link permettera' a una nuova persona di auto-compilarsi il form di iscrizione.
            Scade dopo 14 giorni ed e' utilizzabile una sola volta.
          </p>
        </div>
        <button type="button" id="invite-close" class="text-2xl leading-none text-nx-gray-dark hover:text-nx-dark">×</button>
      </div>

      <!-- Step 1: form -->
      <form id="invite-form" class="mt-4 space-y-4">
        <div>
          <label class="block text-sm font-medium text-nx-dark">Nome destinatario (opzionale)</label>
          <input name="intendedName" placeholder="es. Mario Rossi" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
          <p class="mt-1 text-xs text-nx-gray-dark">Verra' pre-compilato nel form, il destinatario lo puo' modificare.</p>
        </div>
        <div>
          <label class="block text-sm font-medium text-nx-dark">Email destinatario (opzionale)</label>
          <input type="email" name="intendedEmail" placeholder="mario@example.com" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div>
          <label class="block text-sm font-medium text-nx-dark">Nota interna (opzionale)</label>
          <input name="note" placeholder="es. Conoscenza dal MeetLudica di marzo" class="mt-1 block w-full rounded-lg border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div>
          <label class="block text-sm font-medium text-nx-dark">Validita' (giorni)</label>
          <input type="number" name="ttlDays" value="14" min="1" max="90" class="mt-1 block w-32 rounded-lg border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:ring-2 focus:ring-nx-cyan/20" />
        </div>
        <div class="flex gap-3 pt-2">
          <button type="submit" id="invite-submit" class="rounded-lg bg-nx-cyan px-4 py-2.5 text-sm font-bold uppercase tracking-wider text-white shadow-md transition hover:bg-nx-blue disabled:opacity-50">
            Genera link
          </button>
          <button type="button" id="invite-cancel" class="rounded-lg border border-nx-gray-light/40 px-4 py-2.5 text-sm font-semibold text-nx-gray-dark">
            Annulla
          </button>
        </div>
      </form>

      <!-- Step 2: risultato (nascosto fino a generazione) -->
      <div id="invite-result" class="mt-6 hidden space-y-3 rounded-lg border-2 border-emerald-200 bg-emerald-50 p-4">
        <p class="text-sm font-bold text-emerald-900">✓ Link generato</p>
        <div class="rounded-lg border border-emerald-200 bg-white p-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-nx-gray-dark">URL da inviare</p>
          <p id="invite-url" class="mt-2 break-all font-mono text-xs text-nx-dark"></p>
        </div>
        <p id="invite-expires" class="text-xs text-emerald-900"></p>
        <div class="flex flex-wrap gap-2">
          <button type="button" id="invite-copy" class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-white hover:bg-emerald-700">
            📋 Copia link
          </button>
          <a id="invite-mailto" href="#" class="rounded-lg border border-emerald-300 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-900 no-underline hover:bg-emerald-50">
            ✉ Apri email
          </a>
          <button type="button" id="invite-another" class="rounded-lg border border-nx-gray-light/40 bg-white px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-nx-gray-dark hover:border-nx-cyan hover:text-nx-cyan">
            + Genera un altro
          </button>
        </div>
      </div>

      <p id="invite-error" class="mt-3 hidden text-sm text-red-600"></p>
    </div>
  </div>

  <!-- Card grid soci: responsive, niente scroll orizzontale -->
  <div class="mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    {members.map((m) => (
      <a
        href={`/area-soci/admin/${m.id}`}
        class="group flex flex-col gap-4 rounded-xl border border-nx-gray-light/20 bg-white p-5 no-underline transition hover:border-nx-cyan hover:shadow-md"
      >
        <!-- Header: foto + nome + role labels -->
        <div class="flex items-start gap-3">
          {m.photoUrl ? (
            <img src={m.photoUrl} alt="" loading="lazy" decoding="async" class="h-12 w-12 shrink-0 rounded-full object-cover" />
          ) : (
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-nx-cyan-light text-sm font-bold text-nx-cyan">
              {m.name.split(" ").filter(Boolean).map((s) => s[0]).slice(0, 2).join("")}
            </span>
          )}
          <div class="min-w-0 flex-1">
            <p class="truncate font-bold text-nx-dark">{m.name}</p>
            <p class="truncate text-xs text-nx-gray-dark">
              {m.email.endsWith(".invalid") ? <span class="italic text-nx-gray-light">email da definire</span> : m.email}
            </p>
            {m.roleLabel && (
              <p class="mt-0.5 truncate text-xs text-nx-cyan">{m.roleLabel}</p>
            )}
          </div>
        </div>

        <!-- Badges row -->
        <div class="flex flex-wrap gap-2">
          <span class={`inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider ${
            m.role === "admin" ? "bg-nx-cyan-light text-nx-cyan"
            : m.role === "member" ? "bg-blue-100 text-blue-800"
            : "bg-purple-100 text-purple-800"
          }`}>{roleLabels[m.role]}</span>
          <span class={`inline-flex rounded-full px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider ${statusColors[m.membershipStatus]}`}>
            {statusLabels[m.membershipStatus]}
          </span>
          {!m.active && (
            <span class="inline-flex rounded-full bg-red-100 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-red-800">
              Disattivato
            </span>
          )}
        </div>

        <!-- Mini-table: iscrizione + quote -->
        <dl class="grid grid-cols-2 gap-3 border-t border-nx-gray-light/20 pt-3 text-xs">
          <div>
            <dt class="text-nx-gray-dark">Iscritto dal</dt>
            <dd class="mt-0.5 font-medium text-nx-dark">{fmtDate(m.membershipDate)}</dd>
          </div>
          <div>
            <dt class="text-nx-gray-dark">Ultima quota</dt>
            <dd class="mt-0.5 font-medium text-nx-dark">{fmtMoney(m.lastPaymentAmount)}</dd>
            {m.lastPaymentDate && (
              <dd class="text-[11px] text-nx-gray-dark">{fmtDate(m.lastPaymentDate)}</dd>
            )}
          </div>
        </dl>

        <span class="text-right text-xs font-semibold text-nx-cyan transition group-hover:translate-x-0.5">
          Modifica →
        </span>
      </a>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 text-xs text-nx-gray-dark">
    <p>
      Totale: <strong class="text-nx-dark">{members.length}</strong> {members.length === 1 ? "persona registrata" : "persone registrate"}.
    </p>
    <button id="sync-drive-btn" class="rounded-md border border-nx-gray-light/40 px-3 py-1.5 text-xs font-semibold text-nx-gray-dark transition hover:border-nx-cyan hover:text-nx-cyan">
      Sincronizza accessi Drive
    </button>
  </div>
  <p id="sync-drive-status" class="mt-2 text-right text-xs"></p>
</AreaSociLayout>

<script is:inline>
  (function () {
    // === Modal "Genera link iscrizione" ===
    const inviteBtn = document.getElementById("invite-btn");
    const inviteModal = document.getElementById("invite-modal");
    const inviteClose = document.getElementById("invite-close");
    const inviteCancel = document.getElementById("invite-cancel");
    const inviteForm = document.getElementById("invite-form");
    const inviteSubmit = document.getElementById("invite-submit");
    const inviteResult = document.getElementById("invite-result");
    const inviteUrl = document.getElementById("invite-url");
    const inviteExpires = document.getElementById("invite-expires");
    const inviteCopy = document.getElementById("invite-copy");
    const inviteMailto = document.getElementById("invite-mailto");
    const inviteAnother = document.getElementById("invite-another");
    const inviteError = document.getElementById("invite-error");

    function openInviteModal() {
      inviteModal.classList.remove("hidden");
      inviteModal.classList.add("flex");
      // Reset
      inviteForm.classList.remove("hidden");
      inviteResult.classList.add("hidden");
      inviteError.classList.add("hidden");
      inviteError.textContent = "";
    }
    function closeInviteModal() {
      inviteModal.classList.add("hidden");
      inviteModal.classList.remove("flex");
    }
    if (inviteBtn) inviteBtn.addEventListener("click", openInviteModal);
    if (inviteClose) inviteClose.addEventListener("click", closeInviteModal);
    if (inviteCancel) inviteCancel.addEventListener("click", closeInviteModal);

    if (inviteForm) {
      inviteForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        inviteSubmit.disabled = true;
        inviteError.classList.add("hidden");
        const fd = new FormData(inviteForm);
        const body = {};
        for (const [k, v] of fd.entries()) if (v) body[k] = v;
        if (body.ttlDays) body.ttlDays = Number(body.ttlDays);
        try {
          const res = await fetch("/api/admin/invitations", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body),
          });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            inviteError.textContent = "Errore: " + (data.error || res.status);
            inviteError.classList.remove("hidden");
            inviteSubmit.disabled = false;
            return;
          }
          // Mostra risultato
          inviteUrl.textContent = data.invitation.url;
          const expiresDate = new Date(data.invitation.expiresAt).toLocaleString("it-IT");
          inviteExpires.textContent = "Valido fino al " + expiresDate + ".";
          // Setup mailto
          const subject = encodeURIComponent("Iscrizione a NexLudica APS");
          const greeting = body.intendedName ? "Ciao " + body.intendedName + ",\n\n" : "Ciao,\n\n";
          const bodyText = encodeURIComponent(
            greeting +
            "ecco il link per completare la tua iscrizione a NexLudica APS:\n\n" +
            data.invitation.url +
            "\n\nIl link e' valido fino al " + expiresDate + " e puo' essere usato una sola volta.\n\n" +
            "Per qualsiasi dubbio, rispondi pure a questa email.\n\nGrazie!"
          );
          const to = body.intendedEmail ? encodeURIComponent(body.intendedEmail) : "";
          inviteMailto.href = "mailto:" + to + "?subject=" + subject + "&body=" + bodyText;
          inviteForm.classList.add("hidden");
          inviteResult.classList.remove("hidden");
          inviteSubmit.disabled = false;
        } catch (err) {
          inviteError.textContent = "Errore di rete";
          inviteError.classList.remove("hidden");
          inviteSubmit.disabled = false;
        }
      });
    }

    if (inviteCopy) {
      inviteCopy.addEventListener("click", async () => {
        const text = inviteUrl.textContent || "";
        try {
          await navigator.clipboard.writeText(text);
          inviteCopy.textContent = "✓ Copiato";
          setTimeout(() => { inviteCopy.textContent = "📋 Copia link"; }, 1500);
        } catch (e) {
          // Fallback: select
          const range = document.createRange();
          range.selectNode(inviteUrl);
          window.getSelection().removeAllRanges();
          window.getSelection().addRange(range);
        }
      });
    }
    if (inviteAnother) {
      inviteAnother.addEventListener("click", () => {
        inviteForm.reset();
        inviteForm.classList.remove("hidden");
        inviteResult.classList.add("hidden");
      });
    }

    // === Sync Drive editors ===
    const syncBtn = document.getElementById("sync-drive-btn");
    const syncStatus = document.getElementById("sync-drive-status");
    if (syncBtn && syncStatus) {
      syncBtn.addEventListener("click", async () => {
        syncBtn.disabled = true;
        syncStatus.textContent = "Sincronizzazione in corso...";
        syncStatus.className = "mt-2 text-right text-xs text-nx-gray-dark";
        try {
          const res = await fetch("/api/admin/sync-drive", { method: "POST" });
          const data = await res.json();
          if (!res.ok || !data.ok) {
            syncStatus.textContent = "Errore: " + (data.error || res.status);
            syncStatus.className = "mt-2 text-right text-xs text-red-600";
          } else {
            const parts = [];
            if (data.granted && data.granted.length) parts.push(data.granted.length + " aggiunti");
            if (data.skipped && data.skipped.length) parts.push(data.skipped.length + " gia' editor");
            if (data.errors && data.errors.length) parts.push(data.errors.length + " errori");
            syncStatus.textContent = "✓ " + (parts.join(", ") || "Nessun cambiamento");
            syncStatus.className = "mt-2 text-right text-xs text-emerald-600";
          }
        } catch (e) {
          syncStatus.textContent = "Errore di rete";
          syncStatus.className = "mt-2 text-right text-xs text-red-600";
        } finally {
          syncBtn.disabled = false;
        }
      });
    }
  })();
</script>
