---
/**
 * Editor dei template di sistema delle checklist (game_id = NULL).
 *
 * Le modifiche qui valgono per TUTTI i giochi che non hanno una copia
 * personalizzata. Da usare durante la fase di testing per affinare i
 * default basandosi sull'esperienza accumulata.
 */
import PlaytestLayout from "../../layouts/PlaytestLayout.astro";
import { getDb, getEnv } from "../../server/db";
import { getUser } from "../../server/guards";
import { listChecklistItems, type ChecklistItem } from "../../server/playtest";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store, max-age=0, must-revalidate");

const user = await getUser(Astro);
if (!user) {
  const nextUrl = encodeURIComponent(new URL(Astro.request.url).toString());
  return Astro.redirect(`https://nexludica.org/login?next=${nextUrl}`);
}

const env = await getEnv();
const db = getDb(env as Env);

let obsItems: ChecklistItem[] = [];
let setupItems: ChecklistItem[] = [];
if (db) {
  // gameId omesso → recupera template di sistema (game_id NULL)
  obsItems = await listChecklistItems(db, "observation");
  setupItems = await listChecklistItems(db, "setup");
}

const bootstrap = { obsItems, setupItems };
---

<PlaytestLayout
  title="Checklist default — Playtest"
  crumbs={[{ label: "Checklist default" }]}
>
  <section class="rounded-xl bg-white p-6 shadow-sm">
    <p class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Template di sistema</p>
    <h1 class="mt-2 text-2xl font-black tracking-tight text-nx-dark sm:text-3xl" style="font-family: var(--font-display);">
      Checklist default
    </h1>
    <div class="mt-3 rounded-md bg-amber-50 border border-amber-200 p-3 text-sm text-amber-900">
      <strong>Attenzione:</strong> queste sono le checklist predefinite valide per <em>tutti</em>
      i giochi che non hanno una copia personalizzata. Modifiche qui hanno effetto globale.
      Sessioni già compilate non vengono toccate (le risposte restano legate al testo del momento).
    </div>
  </section>

  <div class="mt-6 flex gap-1 border-b border-nx-gray-light/30">
    <button data-tab="observation" class="nx-tab nx-tab-active">Osservazione (Inizio/Fine/Partecipata)</button>
    <button data-tab="setup" class="nx-tab">Set-up</button>
  </div>

  <section data-panel="observation" class="mt-6 space-y-4">
    <div id="obs-list" class="space-y-2"></div>
    <button id="obs-add" class="rounded-md bg-nx-cyan px-4 py-2 text-sm font-bold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
      + Nuovo item osservativo
    </button>
  </section>

  <section data-panel="setup" class="mt-6 hidden space-y-4">
    <div id="setup-list" class="space-y-2"></div>
    <button id="setup-add" class="rounded-md bg-nx-cyan px-4 py-2 text-sm font-bold text-white shadow transition hover:-translate-y-0.5 hover:shadow-lg">
      + Nuovo item set-up
    </button>
  </section>

  {/* Modal edit/add */}
  <div id="item-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-nx-dark/50 backdrop-blur-sm">
    <div class="mx-4 w-full max-w-lg rounded-xl bg-white p-6 shadow-2xl">
      <h2 id="item-modal-title" class="text-xl font-bold text-nx-dark">Item</h2>
      <form id="item-form" class="mt-4 space-y-3">
        <input type="hidden" name="id" />
        <input type="hidden" name="appliesTo" />
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-nx-dark">Categoria *</label>
            <input name="category" required maxlength="80" placeholder="es. ERGONOMIA FISICA"
              class="mt-1 w-full rounded-md border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-nx-dark">Sottocategoria</label>
            <input name="subcategory" maxlength="80" placeholder="es. Seduta"
              class="mt-1 w-full rounded-md border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:outline-none" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-nx-dark">Domanda / testo dell'item *</label>
          <textarea name="text" required rows="3" maxlength="400"
            placeholder="Es. I giocatori sembrano divertirsi?"
            class="mt-1 w-full rounded-md border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:outline-none"></textarea>
          <p class="mt-1 text-[11px] text-nx-gray-dark">Formula sempre in positivo: la scala 0–10 è "più alto = meglio".</p>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-nx-dark">Posizione (ordine)</label>
          <input name="position" type="number" placeholder="es. 100"
            class="mt-1 w-32 rounded-md border border-nx-gray-light/40 px-3 py-2 text-sm focus:border-nx-cyan focus:outline-none" />
        </div>
        <p id="item-err" class="hidden rounded-md bg-red-50 px-3 py-2 text-sm text-red-700"></p>
        <div class="flex items-center justify-end gap-2 border-t border-nx-gray-light/20 pt-3">
          <button type="button" id="item-cancel" class="rounded-md px-3 py-2 text-sm font-semibold text-nx-gray-dark hover:text-nx-cyan">Annulla</button>
          <button type="submit" class="rounded-md bg-nx-cyan px-4 py-2 text-sm font-bold text-white">Salva</button>
        </div>
      </form>
    </div>
  </div>

  <script type="application/json" id="bootstrap" set:html={JSON.stringify(bootstrap)} />

  <style is:global>
    .nx-tab {
      padding: 0.5rem 1rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.05em; color: rgb(102 102 102); border-bottom: 3px solid transparent;
      margin-bottom: -1px; cursor: pointer; transition: all 0.15s;
    }
    .nx-tab:hover { color: #05abc4; }
    .nx-tab-active { color: #05abc4; border-bottom-color: #05abc4; }
  </style>

  <script is:inline>
    const boot = JSON.parse(document.getElementById("bootstrap").textContent || "{}");
    const state = {
      observation: { items: boot.obsItems },
      setup: { items: boot.setupItems },
    };

    function esc(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    }

    document.querySelectorAll(".nx-tab").forEach((t) => {
      t.addEventListener("click", () => {
        const k = t.dataset.tab;
        document.querySelectorAll(".nx-tab").forEach((x) => x.classList.toggle("nx-tab-active", x === t));
        document.querySelectorAll("[data-panel]").forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== k));
      });
    });

    function renderList(appliesTo) {
      const listEl = document.getElementById(appliesTo === "observation" ? "obs-list" : "setup-list");
      const items = state[appliesTo].items;
      listEl.innerHTML = "";
      if (items.length === 0) {
        listEl.innerHTML = `<div class="rounded-md border-2 border-dashed border-nx-gray-light/40 bg-white p-6 text-center text-sm text-nx-gray-dark">Nessun item.</div>`;
        return;
      }
      const byCat = new Map();
      for (const it of items) {
        const k = it.category;
        if (!byCat.has(k)) byCat.set(k, []);
        byCat.get(k).push(it);
      }
      for (const [cat, group] of byCat) {
        const block = document.createElement("div");
        block.className = "rounded-lg bg-white shadow-sm";
        block.innerHTML = `<div class="border-b border-nx-gray-light/20 px-4 py-2 text-xs font-bold uppercase tracking-wider text-nx-cyan">${esc(cat)}</div>`;
        const ul = document.createElement("ul");
        ul.className = "divide-y divide-nx-gray-light/20";
        for (const it of group) {
          const li = document.createElement("li");
          li.className = "flex items-start justify-between gap-3 px-4 py-3";
          li.innerHTML = `
            <div class="min-w-0 flex-1">
              ${it.subcategory ? `<p class="text-[10px] font-bold uppercase tracking-wider text-nx-gray-dark">${esc(it.subcategory)}</p>` : ""}
              <p class="text-sm text-nx-dark">${esc(it.text)}</p>
              <p class="mt-1 text-[10px] text-nx-gray-dark">Pos: ${it.position} · ID: <code>${esc(it.id)}</code></p>
            </div>
            <div class="flex shrink-0 gap-2">
              <button data-action="edit" data-applies="${appliesTo}" data-id="${it.id}" class="text-xs font-semibold text-nx-cyan hover:underline">Modifica</button>
              <button data-action="delete" data-applies="${appliesTo}" data-id="${it.id}" class="text-xs font-semibold text-red-500 hover:text-red-700">Elimina</button>
            </div>`;
          ul.appendChild(li);
        }
        block.appendChild(ul);
        listEl.appendChild(block);
      }
    }

    const modal = document.getElementById("item-modal");
    const form = document.getElementById("item-form");
    function openModal({ id, appliesTo, category, subcategory, text, position }) {
      form.id.value = id || "";
      form.appliesTo.value = appliesTo;
      form.category.value = category || "";
      form.subcategory.value = subcategory || "";
      form.text.value = text || "";
      form.position.value = position != null ? position : "";
      document.getElementById("item-modal-title").textContent = id ? "Modifica item default" : "Nuovo item default";
      document.getElementById("item-err").classList.add("hidden");
      modal.classList.remove("hidden"); modal.classList.add("flex");
    }
    function closeModal() { modal.classList.add("hidden"); modal.classList.remove("flex"); }
    document.getElementById("item-cancel").addEventListener("click", closeModal);
    modal.addEventListener("click", (e) => { if (e.target === modal) closeModal(); });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const errEl = document.getElementById("item-err");
      errEl.classList.add("hidden");
      const payload = {
        category: form.category.value.trim(),
        subcategory: form.subcategory.value.trim() || null,
        text: form.text.value.trim(),
        position: form.position.value ? Number(form.position.value) : undefined,
        appliesTo: form.appliesTo.value,
      };
      try {
        let r;
        if (form.id.value) {
          r = await fetch(`/api/playtest/checklist-items/${form.id.value}`, {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
        } else {
          r = await fetch(`/api/playtest/checklist-items`, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
        }
        const j = await r.json();
        if (!r.ok || !j.ok) throw new Error(j.error || "Errore");
        closeModal();
        await refresh(payload.appliesTo);
      } catch (e) {
        errEl.textContent = e.message;
        errEl.classList.remove("hidden");
      }
    });

    document.body.addEventListener("click", async (e) => {
      const btn = e.target.closest("[data-action]");
      if (!btn) return;
      const action = btn.dataset.action;
      const appliesTo = btn.dataset.applies;
      if (action === "edit") {
        const it = state[appliesTo].items.find((x) => x.id === btn.dataset.id);
        if (it) openModal({ id: it.id, appliesTo, category: it.category, subcategory: it.subcategory, text: it.text, position: it.position });
      } else if (action === "delete") {
        if (!confirm("Eliminare definitivamente l'item dai default? Tutti i giochi senza override perderanno questo item.")) return;
        await fetch(`/api/playtest/checklist-items/${btn.dataset.id}`, { method: "DELETE" });
        await refresh(appliesTo);
      }
    });

    document.getElementById("obs-add").addEventListener("click", () => openModal({ appliesTo: "observation", position: 9999 }));
    document.getElementById("setup-add").addEventListener("click", () => openModal({ appliesTo: "setup", position: 9999 }));

    async function refresh(appliesTo) {
      // Ricarico chiamando l'endpoint sui giochi con un id fittizio.
      // Più semplice: hard reload della pagina.
      window.location.reload();
    }

    renderList("observation");
    renderList("setup");
  </script>
</PlaytestLayout>
