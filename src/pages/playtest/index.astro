---
/**
 * Landing della piattaforma di playtest. Lista dei giochi.
 *
 * URL pubblico: https://playtest.nexludica.org/
 * Riscritto dal middleware da playtest.nexludica.org/ → /playtest/
 */
import PlaytestLayout from "../../layouts/PlaytestLayout.astro";
import { getDb, getEnv } from "../../server/db";
import { getUser } from "../../server/guards";
import { listGames, type Game } from "../../server/playtest";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "no-store, max-age=0, must-revalidate");

const user = await getUser(Astro);
if (!user) {
  const nextUrl = encodeURIComponent(new URL(Astro.request.url).toString());
  return Astro.redirect(`https://nexludica.org/login?next=${nextUrl}`);
}

const env = await getEnv();
const db = getDb(env as Env);
let games: Game[] = [];
if (db) {
  try {
    games = await listGames(db, { onlyActive: false });
  } catch (e) {
    console.error("[playtest] listGames failed", e);
  }
}

function durationLabel(g: Game): string {
  if (g.durationMinMinutes && g.durationMaxMinutes) {
    return `${g.durationMinMinutes}–${g.durationMaxMinutes} min`;
  }
  if (g.durationMinMinutes) return `${g.durationMinMinutes}+ min`;
  return "—";
}
function playersLabel(g: Game): string {
  if (g.playersMin && g.playersMax) return `${g.playersMin}–${g.playersMax}`;
  if (g.playersMin) return `${g.playersMin}+`;
  return "—";
}
---

<PlaytestLayout title="NexLudica Playtest" description="Piattaforma di playtest di NexLudica APS.">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.3em] text-nx-cyan">Playtest Platform</p>
      <h1 class="mt-2 text-4xl font-black tracking-tight text-nx-dark sm:text-5xl" style="font-family: var(--font-display);">
        Giochi in playtest
      </h1>
      <p class="mt-3 max-w-2xl text-nx-gray-dark">
        Ogni gioco è un progetto con la propria procedura di playtest e i propri dati raccolti.
        Crea un nuovo gioco per iniziare, oppure entra in uno esistente per vedere le sessioni o avviarne una nuova.
      </p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <a
        href="/giochi/nuovo"
        class="rounded-md bg-nx-cyan px-4 py-2.5 text-sm font-bold text-white no-underline shadow transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        + Nuovo gioco
      </a>
      <a
        href="/checklist-default"
        class="rounded-md border border-nx-gray-light/40 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-nx-dark no-underline transition hover:border-nx-cyan hover:text-nx-cyan"
      >
        ✎ Checklist default
      </a>
    </div>
  </section>

  <section class="mt-10">
    {games.length === 0 ? (
      <div class="rounded-lg border-2 border-dashed border-nx-gray-light/40 bg-white p-10 text-center">
        <p class="text-lg font-bold text-nx-dark">Ancora nessun gioco</p>
        <p class="mt-2 text-sm text-nx-gray-dark">
          Crea il primo gioco per iniziare a tracciare playtest, turni, checklist e osservazioni.
        </p>
        <a href="/giochi/nuovo" class="mt-6 inline-block rounded-md bg-nx-cyan px-4 py-2 text-sm font-bold text-white no-underline">
          Crea il primo gioco
        </a>
      </div>
    ) : (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {games.map((g) => (
          <a
            href={`/giochi/${g.slug}`}
            class={`group block overflow-hidden rounded-xl border border-nx-gray-light/20 bg-white no-underline transition hover:-translate-y-1 hover:border-nx-cyan hover:shadow-lg ${g.status === "archived" ? "opacity-60" : ""}`}
          >
            {g.coverUrl ? (
              <div class="aspect-[16/9] overflow-hidden bg-nx-off-white">
                <img src={g.coverUrl} alt={g.name} class="h-full w-full object-cover transition group-hover:scale-105" />
              </div>
            ) : (
              <div class="flex aspect-[16/9] items-center justify-center bg-nx-cyan-light">
                <span class="px-4 text-center text-3xl font-black text-nx-cyan">{g.name}</span>
              </div>
            )}
            <div class="p-5">
              <div class="flex items-start justify-between gap-2">
                <p class="text-lg font-bold text-nx-dark">{g.name}</p>
                {g.status === "archived" && (
                  <span class="rounded-full bg-nx-gray-light/30 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-nx-gray-dark">Archiviato</span>
                )}
              </div>
              {g.shortDescription && (
                <p class="mt-2 line-clamp-2 text-sm text-nx-gray-dark">{g.shortDescription}</p>
              )}
              <dl class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs text-nx-gray-dark">
                <div><dt class="font-semibold">Giocatori:</dt> <dd class="inline">{playersLabel(g)}</dd></div>
                <div><dt class="font-semibold">Durata:</dt> <dd class="inline">{durationLabel(g)}</dd></div>
                {g.minAge && <div><dt class="font-semibold">Età:</dt> <dd class="inline">{g.minAge}+</dd></div>}
              </dl>
              {g.designers && (
                <p class="mt-3 truncate text-xs text-nx-gray-dark">
                  <span class="font-semibold">Design:</span> {g.designers}
                </p>
              )}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</PlaytestLayout>
